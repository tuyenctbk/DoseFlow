<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Shadow for Capsule Pill & Droplet Fusion -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45"
        android:translateX="1.5"
        android:translateY="2.5">
        <path
            android:pathData="M42,43 C35.925,43 31,47.925 31,54 C31,60.075 35.925,65 42,65 L66,65 C72.075,65 77,60.075 77,54 C77,47.925 72.075,43 66,43 Z"
            android:fillColor="#50000000" />
    </group>

    <!-- 45-Degree Angled Medical Capsule Pill -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">

        <!-- Active Half: Electric Violet & Amethyst Gradient -->
        <path
            android:pathData="M42,43 C35.925,43 31,47.925 31,54 C31,60.075 35.925,65 42,65 L54,65 L54,43 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="31"
                    android:startY="43"
                    android:endX="54"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFC084FC" />
                    <item android:offset="0.6" android:color="#FFA855F7" />
                    <item android:offset="1.0" android:color="#FF7E22CE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Base Half: Ceramic Pearl White with Soft Shadow Shading -->
        <path
            android:pathData="M54,43 L66,43 C72.075,43 77,47.925 77,54 C77,60.075 72.075,65 66,65 L54,65 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="43"
                    android:endX="77"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFF8FAFC" />
                    <item android:offset="0.75" android:color="#FFE2E8F0" />
                    <item android:offset="1.0" android:color="#FFCBD5E1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Pill Central Seam Divider Line -->
        <path
            android:pathData="M54,43 L54,65"
            android:strokeWidth="1.5"
            android:strokeColor="#FF0F172A" />

        <!-- Specular Pill Surface Reflection -->
        <path
            android:pathData="M37,46 C34,48 33.5,51 33.5,52"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.7"
            android:strokeLineCap="round" />
    </group>

    <!-- Droplet Drop-Shadow -->
    <path
        android:pathData="M63,39 C63,39 49,57 49,67 C49,75.837 55.268,82 63,82 C70.732,82 77,75.837 77,67 C77,57 63,39 63,39 Z"
        android:fillColor="#45000000" />

    <!-- Luminous Fluid Water Droplet (Hydration & Flow) -->
    <path
        android:pathData="M62,37 C62,37 48,55 48,65 C48,73.837 54.268,80 62,80 C69.732,80 76,73.837 76,65 C76,55 62,37 62,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="37"
                android:endX="76"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF38BDF8" />
                <item android:offset="0.5" android:color="#FF06B6D4" />
                <item android:offset="1.0" android:color="#FF0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Water Droplet Specular Reflection Curve -->
    <path
        android:pathData="M56,61 C56,57 59.5,50 60.5,48 C60.5,48 61.5,52 61.5,56 C61.5,60 59.5,62 58,62 C57.2,62 56,61.6 56,61 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.78" />

    <!-- Secondary Micro Droplet Glint -->
    <path
        android:pathData="M68,69 C68,68 69,67 70,67 C70.5,67 71,67.5 71,68 C71,69 70,70 69,70 C68.5,70 68,69.5 68,69 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.8" />

    <!-- Vitality Energy Sparkle (Emerald Glow at Upper-Left) -->
    <path
        android:pathData="M37,27 L38.5,30.5 L42,32 L38.5,33.5 L37,37 L35.5,33.5 L32,32 L35.5,30.5 Z"
        android:fillColor="#FF34D399" />

    <path
        android:pathData="M37,29.5 L37.8,31.2 L39.5,32 L37.8,32.8 L37,34.5 L36.2,32.8 L34.5,32 L36.2,31.2 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.9" />

    <!-- Subtle Secondary Micro-Sparkle (Cyan at Upper-Right) -->
    <path
        android:pathData="M78,38 L79,40 L81,41 L79,42 L78,44 L77,42 L75,41 L77,40 Z"
        android:fillColor="#FF38BDF8"
        android:fillAlpha="0.85" />
</vector>
